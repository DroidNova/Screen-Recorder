<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardUseCompatPadding="true"
    android:backgroundTint="@color/cardBackgroundColor"
    app:strokeColor="@color/card_stroke_color"
    app:strokeWidth=".5dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fl_thumbnail"
            android:layout_width="100dp"
            android:layout_height="80dp"
            app:cardCornerRadius="5dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/cardBackgroundColor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_video_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/recordings_filled"
                android:scaleType="centerCrop"
                android:contentDescription="Video" />

            <TextView
                android:id="@+id/tv_video_length"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="2dp"
                android:layout_margin="5dp"
                android:textColor="#ffffff"
                android:background="#99000000"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_video_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Video Name"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:textColor="@color/textColorPrimary"
            app:layout_constraintTop_toTopOf="@id/fl_thumbnail"
            app:layout_constraintStart_toEndOf="@id/fl_thumbnail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_video_creation_date" />

        <TextView
            android:id="@+id/tv_video_creation_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="12sp"
            android:textColor="@color/textColorSecondary"
            app:layout_constraintTop_toBottomOf="@id/tv_video_name"
            app:layout_constraintStart_toStartOf="@id/tv_video_name"
            app:layout_constraintBottom_toTopOf="@id/tv_video_size" />

        <TextView
            android:id="@+id/tv_video_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Size: 0 KB"
            android:textSize="12sp"
            android:textColor="@color/textColorSecondary"
            app:layout_constraintTop_toBottomOf="@id/tv_video_creation_date"
            app:layout_constraintStart_toStartOf="@id/tv_video_creation_date"
            app:layout_constraintBottom_toBottomOf="@id/fl_thumbnail"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
