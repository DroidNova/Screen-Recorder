<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.screens.homescreen.HomeScreenFragment">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Video Recorder"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        />

    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="4dp"
            android:gravity="bottom|center_horizontal"
            >
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                >

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_storage"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:progress="70"
                    app:trackColor="#E8E3E3"
                    app:indicatorInset="0dp"
                    app:indicatorSize="54dp"
                    />

                <TextView
                    android:id="@+id/tv_storage_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="55%\nFull"
                    android:textColor="@color/button_text_color"
                    android:textSize="10sp"
                    />

            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/button_text_color"
                android:gravity="center"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal"
            android:layout_margin="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quality"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:text="12Mbps"
                android:textSize="12sp"
                android:textColor="@color/button_text_color"
                android:backgroundTint="@color/cardBackgroundColor"
                style="?attr/materialButtonOutlinedStyle"
                app:cornerRadius="27dp"
                app:backgroundTintMode="src_over"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Quality"
                android:textColor="@color/button_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal"
            android:layout_margin="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resolution"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:text="720p"
                android:textSize="12sp"
                android:textColor="@color/button_text_color"
                android:backgroundTint="@color/cardBackgroundColor"
                style="?attr/materialButtonOutlinedStyle"
                app:cornerRadius="27dp"
                app:backgroundTintMode="src_over"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolution"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/button_text_color"
                android:gravity="center"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal"
            android:layout_margin="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fps"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:backgroundTint="@color/cardBackgroundColor"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="60"
                android:textColor="@color/button_text_color"
                android:textSize="12sp"
                app:backgroundTintMode="src_over"
                app:cornerRadius="27dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fps"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/button_text_color"
                android:gravity="center"
                />
        </LinearLayout>


    </LinearLayout>

    <TextView
        android:id="@+id/tv_recording_time"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="14dp"
        android:gravity="center"
        android:background="@drawable/textview_outline"
        android:textColor="@color/button_text_color"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btn_start_recording"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btn_start_recording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:layout_marginBottom="32dp"
        android:text="Start"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>