<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Permissions Required"
        android:gravity="center_horizontal"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        />

    <!-- Audio Permission Section -->
    <LinearLayout
        android:id="@+id/layoutAudioPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp"
        android:foreground="?selectableItemBackgroundBorderless"
        >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio Permission"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allows the app to record audio for screen recordings."
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_allow_audio_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            app:cornerRadius="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>

    <!-- Overlay Permission Section -->
    <LinearLayout
        android:id="@+id/layoutOverlayPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:foreground="?selectableItemBackgroundBorderless"
        android:gravity="center_vertical"
        >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overlay Permission"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allows the app to record your screen by drawing an overlay on top of other apps."
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_allow_overlay_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            app:cornerRadius="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>

    <!-- Notification Permission Section -->
    <LinearLayout
        android:id="@+id/layoutNotificationPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:foreground="?selectableItemBackgroundBorderless"
        >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Permission"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allows the app to display notifications with controls to stop, pause, and play the screen recording."
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_allow_notification_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            app:cornerRadius="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>

</LinearLayout>
